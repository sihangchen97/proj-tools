# 功能测试沙盒（pixi run e2e 每次重建）
.testproj/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# pixi environments (与 ecs-gpu 一致：lock 不提交)
.pixi/
.pixi-build/
pixi.lock

# 真机/本地配置（只提交 *.example.* 模板）
config.toml
config.json
!config.example.toml
!config.example.json
.env
/.env.example

# 数据库文件（DB 在 <project>/.proj.sqlite，默认提交；其余 *.sqlite 兜底防误提交）
*.sqlite
*.sqlite3
*.db
!.proj.sqlite

# MCP server 本地配置（含路径/密钥，勿提交）
mcp_settings.json

# 运行时缓存 / 日志（MCP server、CLI 生成）
*.cache.json
logs/

# 本地工具状态
.roo/
.roomodes

# 本地参考资料
reference/

# OS / editor
.DS_Store
.idea/
.vscode/

# 删除暂存区（按仓库规则 mv 过来，定期手工清理）
tobedelete/

# 本地设计/计划文档（不随发布分发）
plans/
